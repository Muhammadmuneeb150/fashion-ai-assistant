PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/fashion_ai_assistant
OPENAI_API_KEY=
BRAND_NAME=FashionHub

# Meta App credentials — needed for the "Connect Instagram / Facebook" buttons
# in the admin dashboard. Create an app at developers.facebook.com, add the
# "Facebook Login for Business" product, and set the redirect URI there to
# match META_REDIRECT_URI below exactly.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/api/meta/callback
META_WEBHOOK_VERIFY_TOKEN=choose-any-random-string-yourself

# The storefront URL the AI agent links customers to from Instagram/Messenger DMs
SITE_URL=http://localhost:5500

# Fill these in once you're ready to wire up real messaging channels
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
